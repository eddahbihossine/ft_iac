environment = "dev"

# Friendly region selector (recommended)
region_choice = "Paris" # also supports: EU, Ireland, Frankfurt, Stockholm, Virginia, Ohio

# Cost profile
cost_profile = "free" # free | standard

# Paid components (must stay false in free mode)
enable_alb       = false
enable_cloudfront = false

# Lock SSH to your IP (required for single-EC2 provisioning).
# Example: "203.0.113.10/32"
ssh_ingress_cidr = ""

# When enable_alb=false, the app is directly reachable on port 3000.
public_app_ingress_cidr = "0.0.0.0/0"

# Advanced override (optional)
# aws_region = "eu-west-3"

# Friendly capacity tiers
server_size = "small" # small | medium | large

# Optional managed DB
enable_database = false
db_size         = "small" # small | medium | large
# db_multi_az   = false
# db_name     = "app"
# db_username = "app"
# db_password is NOT required: Terraform uses an AWS-managed master password (Secrets Manager)

# Optional alerts
# alert_email = "alerts@example.com"
# alert_target_5xx_threshold = 1
# alert_period_seconds       = 300

# Leave unset to use the default AWS credential chain or export AWS_PROFILE.
# aws_profile = "your-profile"

ssh_key_name         = "terraform-deployer"
ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
ssh_private_key_path = "~/.ssh/id_ed25519"

# Single-EC2 mode only: provide these via environment variables (do not commit secrets)
# TF_VAR_mysql_root_password="..."
# TF_VAR_mysql_password="..."
# mysql_user     = "user"
# mysql_database = "todo_app"

# HA mode (enable_alb=true): Auto Scaling Group sizing
# asg_min_size         = 2
# asg_desired_capacity = 2
# asg_max_size         = 4

# Optional DNS / TLS settings
# hosted_zone_id = "Z1234567890"
# domain_name    = "app.example.com"

enable_cloudfront = false

# Optional resource name overrides (useful if your account already has similarly named ALB/TG resources)
# alb_name          = "dev-alb-iac"
# target_group_name = "dev-tg-iac"